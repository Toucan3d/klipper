# Test case for filament_encoder
DICTIONARY stm32f446.dict
CONFIG filament_encoder.cfg
CONFIG filament_encoder_order.cfg

# Query and reset, default and named encoder
ENCODER_QUERY
ENCODER_QUERY ENCODER=sfs
ENCODER_QUERY ENCODER=aux
ENCODER_RESET
ENCODER_RESET ENCODER=sfs ALL=1
QUERY_FILAMENT_SENSOR SENSOR=sfs_runout

# Monitor run with extrusion
M83
G1 E5 F300
FLOW_MONITOR_START ENCODER=sfs INTERVAL=1 LABEL=pla_230_200 LOG=1
G1 E50 F5000
FLOW_MONITOR_STOP ENCODER=sfs WAIT=1
_CHECK_FLOW MIN_RATIO=95
_CHECK_STATUS

# Restart while active, stop twice, no status lines
FLOW_MONITOR_START INTERVAL=0
FLOW_MONITOR_START LABEL=second
G1 E10 F3000
FLOW_MONITOR_STOP
FLOW_MONITOR_STOP
FLOW_MONITOR_START ENCODER=aux
FLOW_MONITOR_STOP ENCODER=aux
