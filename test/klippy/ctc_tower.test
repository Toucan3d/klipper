# Test case for ctc_tower
CONFIG ctc_tower.cfg
DICTIONARY atmega2560.dict

MANUAL_STEPPER STEPPER=ctc_axis SET_POSITION=0
MANUAL_STEPPER STEPPER=ctc_axis GCODE_AXIS=A
CTC_TOWER START=1 LAYER_DELTA=0.6

G1 X1 Z0.5 A10 F600
ASSERT_CTC_TOWER_A GCODE=10 TOOLHEAD=10

G1 X2 Z1 A10
ASSERT_CTC_TOWER_A GCODE=10 TOOLHEAD=190

G1 X3 Z1.3 A20
ASSERT_CTC_TOWER_A GCODE=20 TOOLHEAD=200

G1 X4 Z1.6 A20
ASSERT_CTC_TOWER_A GCODE=20 TOOLHEAD=20

G1 X5 Z2.2 A30
ASSERT_CTC_TOWER_A GCODE=30 TOOLHEAD=210

ABORT_CTC_TOWER
G1 X5 Z3 A50
ASSERT_CTC_TOWER_A GCODE=50 TOOLHEAD=50

MANUAL_STEPPER STEPPER=ctc_axis GCODE_AXIS=
G1 X6 Z7
ASSERT_CTC_TOWER_UNREGISTERED
