# Test case for filament_encoder with an angle sensor
DICTIONARY stm32f446.dict
CONFIG filament_encoder_angle.cfg

ENCODER_QUERY
ENCODER_QUERY ENCODER=wheel_only
ENCODER_RESET ENCODER=sfs ALL=1
_CHECK_ANGLE

# Monitor run with extrusion
M83
FLOW_MONITOR_START ENCODER=sfs INTERVAL=1 LABEL=angle LOG=1
G1 E20 F1200
FLOW_MONITOR_STOP ENCODER=sfs WAIT=1
FLOW_MONITOR_START ENCODER=wheel_only INTERVAL=0
G1 E-2 F1200
G1 E2 F1200
FLOW_MONITOR_STOP ENCODER=wheel_only
